{
  "github": {
    "silent": true
  },
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.senja.io https://widget.senja.io https://senja-assets.b-cdn.net https://ajax.googleapis.com https://lmsqueezy.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://eu.aptabase.com https://us.aptabase.com https://widget.senja.io https://analytics.senja.io https://app.lemonsqueezy.com https://m1.openfpcdn.io; frame-src https://widget.senja.io https://www.youtube.com https://player.vimeo.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/avatar/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/blogcover/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/faq",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/features",
      "destination": "/#features",
      "permanent": true
    },
    {
      "source": "/documentation",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/sdks",
      "destination": "/docs#sdks",
      "permanent": true
    },
    {
      "source": "/sdk",
      "destination": "/docs#sdks",
      "permanent": true
    },
    {
      "source": "/changelog",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/about#contact",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/legal/privacy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/legal/terms",
      "permanent": true
    },
    {
      "source": "/dpa",
      "destination": "/legal/dpa",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/llms.txt",
      "permanent": false
    },
    {
      "source": "/pricing",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/pricing.md",
      "permanent": false
    },
    {
      "source": "/about",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/about.md",
      "permanent": false
    },
    {
      "source": "/docs",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/docs.md",
      "permanent": false
    },
    {
      "source": "/docs/:slug([a-z0-9-]+)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/docs/:slug.md",
      "permanent": false
    },
    {
      "source": "/for-:slug([a-z0-9-]+)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/for-:slug.md",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/avatar/(.*)",
      "destination": "https://www.gravatar.com/avatar/$1"
    },
    {
      "source": "/p.js",
      "destination": "https://plausible.io/js/script.tagged-events.js"
    },
    {
      "source": "/e",
      "destination": "https://plausible.io/api/event"
    }
  ]
}
