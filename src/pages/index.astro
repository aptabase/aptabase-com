---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PrivacyFirst from "../components/features/PrivacyFirst.astro";
import Simple from "../components/features/Simple.astro";
import Pricing from "../components/Pricing.astro";
import FAQ from "../components/FAQ.astro";
import Testimonials from "../components/Testimonials.astro";
import Developers from "../components/features/Developers.astro";
import { product } from "../data/product";
import { softwareApplication } from "../lib/jsonld";
---

<BaseLayout
  title="Aptabase • Analytics for Mobile, Desktop and Web apps"
  description={product.description}
  markdown="/llms.txt"
  schema={[softwareApplication()]}
>
  <Hero />
  <div id="features">
    <PrivacyFirst />
    <Simple />
    <Developers />
  </div>
  <Pricing />
  <FAQ />
  <Testimonials />
</BaseLayout>
