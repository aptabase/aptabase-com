---
import { sdkPages, sdkHref } from "../data/sdks";
---

<div class="mt-20 mx-auto">
  <p class="tracking-tighter text-gray-700 mb-2">
    <span>Works with the framework of your choice!</span>
  </p>
  <div
    class="grid grid-cols-3 md:grid-cols-6 mx-4 md:mx-20 lg:mx-0 lg:flex items-center mt-8 gap-8"
  >
    {
      sdkPages.map((sdk) => (
        <a href={sdkHref(sdk)}>
          <img class="mx-auto h-14 w-14" src={sdk.page.image} alt={sdk.name} />
        </a>
      ))
    }
  </div>
</div>
