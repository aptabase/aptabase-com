---
/** Compact pricing block for pages that shouldn't repeat the full table. */
import SignUpOrDashboard from "../SignUpOrDashboard.astro";
import { pricingSummary } from "../../lib/markdown";
---

<section
  id="pricing"
  aria-labelledby="pricing-summary-heading"
  class="bg-white py-24 sm:py-32"
>
  <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
    <h2
      id="pricing-summary-heading"
      class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"
    >
      Start free, pay when you grow
    </h2>
    <p class="mt-4 text-lg leading-8 text-gray-600">{pricingSummary()}</p>
    <div class="mt-8 flex items-center justify-center gap-x-6">
      <SignUpOrDashboard />
      <a
        href="/pricing"
        class="text-sm font-semibold leading-6 text-gray-700 hover:text-gray-900"
      >
        See all plans →
      </a>
    </div>
  </div>
</section>
