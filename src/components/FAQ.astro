---
import JsonLd from "./JsonLd.astro";
import { faqs, type Faq } from "../data/faq";
import { faqPage } from "../lib/jsonld";
import { product } from "../data/product";

interface Props {
  /** Defaults to every question. Pass a subset (e.g. pricing) on other pages. */
  items?: Faq[];
}

const { items = faqs } = Astro.props;
---

<section id="faq" aria-labelledby="faq-heading" class="bg-gray-900">
  <JsonLd data={faqPage(items)} />
  <div
    class="mx-auto max-w-7xl divide-y divide-gray-900/10 px-6 py-24 sm:py-32 lg:px-8 lg:py-40"
  >
    <h2
      id="faq-heading"
      class="text-2xl font-bold leading-10 tracking-tight text-white"
    >
      Frequently asked questions
    </h2>
    <p class="mt-6 max-w-2xl text-base leading-7 text-gray-300">
      Can't find the answer you're looking for? <br />
      <a
        href={`mailto:${product.links.email}`}
        class="font-semibold text-blue-400 hover:text-blue-300"
      >
        Send us an email
      </a> and we'll get back to you as soon as we can.
    </p>
    <dl class="mt-10 space-y-8 divide-y divide-gray-300/10">
      {
        items.map((faq) => (
          <div class="pt-8 lg:grid lg:grid-cols-12 lg:gap-8">
            <dt class="text-base font-semibold leading-7 text-white lg:col-span-5">
              {faq.question}
            </dt>
            <dd class="mt-4 lg:col-span-7 lg:mt-0 space-y-6">
              {faq.answers.map((answer) => (
                <p class="text-base leading-7 text-gray-300">{answer}</p>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
