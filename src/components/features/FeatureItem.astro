---
const { title, description, color } = Astro.props;
---

<div class="relative pl-9">
  <dt class="font-semibold text-gray-900">
    <svg
      class={`absolute left-0 top-1 h-5 w-5 ${color}`}
      fill="currentColor"
      aria-hidden="true"
    >
      <use href="#icon-check"></use>
    </svg>
    {title}
  </dt>
  <dd class="mt-2">
    {description}
  </dd>
</div>
