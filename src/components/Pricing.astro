---
import PricingTable from "./pricing/PricingTable.astro";
import PlanFeatures from "./pricing/PlanFeatures.astro";
import {
  freeTier,
  firstPaidTier,
  pricingNotes,
  formatEvents,
  formatPricePerMonth,
} from "../data/pricing";
import { product } from "../data/product";

const summaryStyle =
  "flex items-center justify-between gap-x-4 cursor-pointer list-none p-6 [&::-webkit-details-marker]:hidden rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
---

<section
  id="pricing"
  aria-labelledby="pricing-heading"
  class="bg-white py-24 sm:py-32"
>
  <div class="mx-auto max-w-4xl px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2
        id="pricing-heading"
        class="mt-2 text-4xl font-bold tracking-tight text-gray-900"
      >
        Pricing plans for apps of all sizes
      </h2>
      <p class="text-stone-600">Start free and pay when you grow.</p>
    </div>

    <!--
      Both panels ship fully expanded in the HTML so crawlers, AI agents and
      readers without JavaScript see every tier. The inline script right after
      the panels turns them into an exclusive accordion with "Free" open.
    -->
    <div
      class="mx-auto max-w-xl mt-12 rounded-xl bg-gray-400/5 ring-1 ring-inset ring-gray-200 divide-y divide-gray-900/5"
    >
      <details id="plan-free" open class="group">
        <summary class={summaryStyle}>
          <span
            class="text-2xl font-bold font-title tracking-tight text-gray-900"
          >
            Free
          </span>
          <span class="flex items-center gap-x-3 text-sm text-gray-600">
            up to {formatEvents(freeTier.events)} events/month
            <svg
              class="h-4 w-4 shrink-0 text-gray-400 transition-transform group-open:rotate-180"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M4 6l4 4 4-4"></path>
            </svg>
          </span>
        </summary>
        <div class="px-6 pb-6">
          <p class="text-sm text-gray-600">
            {pricingNotes.noCreditCard} Every plan includes:
          </p>
          <PlanFeatures class="mt-3" />
          <button
            onclick="document.getElementById('register').showModal()"
            class="mt-6 rounded-md block w-full sm:w-auto bg-black px-6 py-2 text-center text-sm text-white shadow-xs hover:bg-black/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
          >
            Try free now!
          </button>
        </div>
      </details>

      <details id="plan-paid" open class="group">
        <summary class={summaryStyle}>
          <span
            class="text-2xl font-bold font-title tracking-tight text-gray-900"
          >
            Pay as you grow
          </span>
          <span class="flex items-center gap-x-3 text-sm text-gray-600">
            from {formatPricePerMonth(firstPaidTier.price)}
            <svg
              class="h-4 w-4 shrink-0 text-gray-400 transition-transform group-open:rotate-180"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M4 6l4 4 4-4"></path>
            </svg>
          </span>
        </summary>
        <div class="px-6 pb-6">
          <PricingTable />
          <p class="mt-6 text-xs uppercase tracking-wide text-gray-500">
            Every plan includes
          </p>
          <PlanFeatures class="mt-3" />
          <p class="mt-4 text-sm text-gray-600">{pricingNotes.overage}</p>
        </div>
      </details>
    </div>
    <script is:inline>
      // Progressive enhancement: the HTML above is fully expanded; with JS we
      // make the two panels an exclusive accordion and collapse the paid one.
      (function () {
        var free = document.getElementById("plan-free");
        var paid = document.getElementById("plan-paid");
        if (!free || !paid) return;
        free.setAttribute("name", "pricing-plans");
        paid.setAttribute("name", "pricing-plans");
        paid.removeAttribute("open");
        free.setAttribute("open", "");
      })();
    </script>

    <p class="mx-auto max-w-xl mt-6 text-center text-sm text-stone-600">
      <a href="/pricing" class="text-primary hover:underline">
        See full pricing details →
      </a>
    </p>

    <p class="mx-auto max-w-xl mt-3 text-center text-sm text-stone-600">
      Prefer to self-host Aptabase? Join our dedicated
      <a
        href={product.links.discord}
        target="_blank"
        class="text-primary inline-block hover:underline"
      >
        #self-hosted
      </a>
      channel to get started.
    </p>

    <div
      class="senja-embed mx-auto max-w-xl mt-12"
      data-id="9e183b87-c526-48d7-95d5-e4f60b8d20ad"
      data-lazyload="false"
    >
    </div>
  </div>
</section>
