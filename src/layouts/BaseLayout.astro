---
import "../styles/global.css";
import "cal-sans";
import "@fontsource/inter";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import RegisterDialog from "../components/RegisterDialog.astro";
import JsonLd from "../components/JsonLd.astro";
import {
  organization,
  website,
  type JsonLd as JsonLdData,
} from "../lib/jsonld";

export interface Props {
  title: string;
  description: string;
  og?: string | undefined;
  /**
   * Path of a Markdown/plain-text twin of this page (e.g. "/pricing.md").
   * Advertised via <link rel="alternate"> so agents can fetch it directly.
   */
  markdown?: string;
  /** Extra JSON-LD objects for this page (Organization + WebSite are always emitted). */
  schema?: JsonLdData[];
}

const url = Astro.url.toString().replace(/\/+$/, "");
const { title, description, og, markdown, schema = [] } = Astro.props;
const markdownType = markdown?.endsWith(".txt")
  ? "text/plain"
  : "text/markdown";
---

<!doctype html>
<html lang="en">
  <head>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={url} />
    {
      markdown && (
        <link
          rel="alternate"
          type={markdownType}
          href={markdown}
          title="Markdown version of this page"
        />
      )
    }
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og ?? "https://aptabase.com/og.png"} />
    <meta name="twitter:site" content="@aptabase" />
    <meta name="twitter:card" content="summary_large_image" />
    <JsonLd data={[organization(), website(), ...schema]} />
    <style is:global>
      :root {
        color-scheme: light;
      }
    </style>
  </head>
  <body>
    <Header />
    <slot />
    <RegisterDialog />
    <Footer />
    <script defer data-domain="aptabase.com" data-api="/e" src="/p.js"></script>
    <script
      async
      type="text/javascript"
      src="https://static.senja.io/dist/platform.js"
    ></script>
    <script>
      window.lemonSqueezyAffiliateConfig = { store: "aptabase" };

      document.addEventListener("DOMContentLoaded", function () {
        setTimeout(() => {
          const script = document.createElement("script");
          script.src = "https://lmsqueezy.com/affiliate.js";
          script.async = true;
          document.body.appendChild(script);
        });
      });
    </script>
  </body>
</html>
